#: inc/cpcff_connector_api.inc.php:186
msgid "Get Form Entries"
msgstr ""

#: inc/cpcff_connector_api.inc.php:188
msgid ""
"Retrieves form submission entries recorded by Calculated Fields Form. "
"Supports optional filtering by form ID(s), date range, payment status, and "
"notification e-mail address. Returns a structured list of entries including "
"all submitted field values."
msgstr ""

#: inc/cpcff_connector_api.inc.php:207
msgid ""
"A single form ID (integer) or a comma-separated list of form IDs (string, "
"e.g. \"3,7,12\") whose entries should be returned. Omit to retrieve entries "
"from all forms."
msgstr ""

#: inc/cpcff_connector_api.inc.php:217
msgid ""
"A text with the complete or partial form name (string, e.g. \"contact "
"form\") whose entries should be returned. Omit to retrieve entries from all "
"forms."
msgstr ""

#: inc/cpcff_connector_api.inc.php:227
msgid ""
"Unix timestamp (inclusive). Only entries created on or after this date-time "
"are returned."
msgstr ""

#: inc/cpcff_connector_api.inc.php:236
msgid ""
"Unix timestamp (inclusive). Only entries created on or before this date-time "
"are returned."
msgstr ""

#: inc/cpcff_connector_api.inc.php:246
msgid ""
"Filter by payment status. Pass 1 to retrieve only paid entries; pass 0 to "
"retrieve only unpaid/pending entries. Omit to retrieve all entries "
"regardless of payment status."
msgstr ""

#: inc/cpcff_connector_api.inc.php:257
msgid ""
"Filter entries by the e-mail address that was used as the notification "
"recipient when the entry was submitted."
msgstr ""

#: inc/cpcff_connector_api.inc.php:268
msgid ""
"REQUIRED. Max entries to return (1-100). If the response has exactly this "
"many entries, the agent MUST paginate by calling again with a higher "
"\"offset\" until the response has fewer than \"limit\" entries."
msgstr ""

#: inc/cpcff_connector_api.inc.php:279
msgid ""
"REQUIRED. Number of entries to skip. Use 0 for the first page, then limit, "
"then 2*limit, etc."
msgstr ""

#: inc/cpcff_connector_api.inc.php:292
msgid "Array of matching form entries, ordered by entry date descending."
msgstr ""

#: inc/cpcff_connector_api.inc.php:309
msgid "Unique entry identifier."
msgstr ""

#: inc/cpcff_connector_api.inc.php:314
